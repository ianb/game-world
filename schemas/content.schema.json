{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content",
  "description": "Everything loaded from the content directory.",
  "type": "object",
  "properties": {
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Building"
      }
    },
    "topics": {
      "description": "The topics conversations can be about. A topic that code uses must be listed here.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/TopicDef"
      }
    },
    "villagers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Villager"
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Zone"
      }
    }
  },
  "required": [
    "zones",
    "buildings",
    "villagers"
  ],
  "$defs": {
    "AnimalKind": {
      "description": "A kind of animal. Every character says how they feel about each kind.",
      "type": "string",
      "enum": [
        "chicken",
        "sheep"
      ]
    },
    "AreaSpec": {
      "description": "A named stretch of ground in a zone.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "id",
        "rect"
      ]
    },
    "Building": {
      "type": "object",
      "properties": {
        "at": {
          "description": "Where building-local (0, 0) lands in the zone.",
          "$ref": "#/$defs/Pos"
        },
        "doors": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/DoorSpec"
          }
        },
        "floors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Floor"
          }
        },
        "id": {
          "type": "string"
        },
        "walls": {
          "$ref": "#/$defs/Walling",
          "default": "timber"
        },
        "zone": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "zone",
        "at",
        "floors"
      ]
    },
    "Crop": {
      "type": "string",
      "enum": [
        "wheat",
        "cabbages",
        "carrots",
        "potatoes",
        "beans",
        "corn",
        "flowers"
      ]
    },
    "DayPattern": {
      "description": "Which days a schedule entry applies to. More specific patterns win over `daily`.",
      "type": "string",
      "enum": [
        "daily",
        "weekday",
        "weekend",
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "DoorEnd": {
      "description": "One end of a door record, in building-local coordinates when `floor` is set, zone\ncoordinates when `zone` is set.",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Pos"
        },
        "floor": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "at"
      ]
    },
    "DoorSpec": {
      "description": "A link between two places (stairs, a cellar hatch, a back gate). Both directions unless\n`one_way`. Doors inside one inline floor, or from an inline floor to its zone, are\n`Opening`s instead.",
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/DoorEnd"
        },
        "hours": {
          "description": "\"06:00-20:00\". Villagers who are not the owner may pass only inside these hours.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "one_way": {
          "type": "boolean",
          "default": false
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "to": {
          "$ref": "#/$defs/DoorEnd"
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "Fetches": {
      "type": "object",
      "properties": {
        "good": {
          "type": "string"
        },
        "keep": {
          "description": "They fetch only enough to bring what is at `to` up to this.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "price": {
          "description": "What they pay the railway for each.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "to": {
          "description": "Where they put it.",
          "type": "string"
        }
      },
      "required": [
        "good",
        "to",
        "price",
        "keep"
      ]
    },
    "FlockSpec": {
      "description": "Animals of one kind that belong to someone and keep to one area. Chickens roost and\nlay in their `coop`; animals without one stay out.",
      "type": "object",
      "properties": {
        "area": {
          "description": "The area they keep to.",
          "type": "string"
        },
        "coop": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "count": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AnimalKind"
        },
        "owner": {
          "description": "The villager they belong to.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "count",
        "owner",
        "area"
      ]
    },
    "Floor": {
      "description": "One floor of a building. Inline floors are composited into the zone grid at footprint\nscale; detached floors are their own place, reached by a door (stairs).",
      "type": "object",
      "properties": {
        "arrival": {
          "description": "Where a debug warp lands. Must be inside a room and off any door tile.",
          "$ref": "#/$defs/Pos"
        },
        "detached": {
          "description": "The stated reason this floor is not inline. Required for a detached floor; the\nvalidator warns on a detached ground floor without one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "level": {
          "description": "0 is the ground floor, negative is below ground.",
          "type": "integer",
          "format": "int8",
          "maximum": 127,
          "minimum": -128
        },
        "objects": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectSpec"
          }
        },
        "openings": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Opening"
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Room"
          }
        }
      },
      "required": [
        "id",
        "level",
        "rooms",
        "arrival"
      ]
    },
    "Flooring": {
      "description": "What a room's floor is made of. Only the views read it.",
      "oneOf": [
        {
          "description": "Light boards: houses and shops.",
          "type": "string",
          "const": "planks"
        },
        {
          "description": "Dark boards: halls, the manor, the tavern.",
          "type": "string",
          "const": "darkplanks"
        },
        {
          "description": "Large stone slabs: the chapel, the town hall.",
          "type": "string",
          "const": "flagstone"
        },
        {
          "description": "Rough stones: workshops, the smithy, barns.",
          "type": "string",
          "const": "cobbles"
        },
        {
          "description": "Black and white tiles: the manor's best rooms.",
          "type": "string",
          "const": "checker"
        },
        {
          "description": "Beaten earth: huts and sheds.",
          "type": "string",
          "const": "earth"
        }
      ]
    },
    "GoodsCount": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "good": {
          "type": "string"
        }
      },
      "required": [
        "good",
        "count"
      ]
    },
    "GoodsPrice": {
      "type": "object",
      "properties": {
        "good": {
          "type": "string"
        },
        "price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "good",
        "price"
      ]
    },
    "Income": {
      "description": "Money that reaches a villager from outside the town on a schedule, such as a pension.",
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "at": {
          "description": "\"HH:MM\" or \"9:00am\"",
          "type": "string"
        },
        "days": {
          "$ref": "#/$defs/DayPattern"
        },
        "what": {
          "description": "What the payment is, as the event log shows it.",
          "type": "string"
        }
      },
      "required": [
        "days",
        "at",
        "amount",
        "what"
      ]
    },
    "ObjectSpec": {
      "type": "object",
      "properties": {
        "activity": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "at": {
          "$ref": "#/$defs/Pos"
        },
        "capacity": {
          "description": "Declared only where contention is wanted. See decisions.md.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "bed, counter, oven, table, chair, stove, shelf, privy, well, cart...",
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "room": {
          "description": "The room, for a building object. Empty for an object placed in a zone.",
          "type": "string",
          "default": ""
        },
        "stock": {
          "description": "Goods on it when the town starts, by name.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0
          },
          "default": {}
        },
        "walkable": {
          "description": "True for things you can stand on or walk through (rugs, doormats). Default blocks.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "kind",
        "at"
      ]
    },
    "Opening": {
      "description": "A walkable gap in a wall between two rooms of the same floor, or between a ground-floor\nroom and the outside (`between` then names one room and the zone is implied).",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Pos"
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "at",
        "between"
      ]
    },
    "PlotSpec": {
      "description": "A bed of tilled ground with one crop.",
      "type": "object",
      "properties": {
        "crop": {
          "$ref": "#/$defs/Crop"
        },
        "household": {
          "description": "The building whose people keep this plot as their garden, in turns, in the early\nevening.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "store": {
          "description": "The object the harvest goes into. Without one, what is grown is eaten at home.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "rect",
        "crop"
      ]
    },
    "Pos": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "RailwaySpec": {
      "description": "A railway line across the zone: goods only. The track is a polyline of zone tiles\njoined by straight runs. Trains stop at the tile beside `platform`.",
      "type": "object",
      "properties": {
        "buys": {
          "description": "What the railway pays for goods left on the platform, each.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GoodsPrice"
          }
        },
        "delivers": {
          "description": "What the shed holds after a stopping train: each train tops it up to these counts.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/GoodsCount"
          }
        },
        "platform": {
          "description": "Where goods for sending are left, and where the train stops.",
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrainRun"
          }
        },
        "shed": {
          "description": "Where delivered goods are left.",
          "type": "string"
        },
        "track": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pos"
          }
        }
      },
      "required": [
        "track",
        "platform",
        "shed",
        "runs"
      ]
    },
    "Rect": {
      "description": "A rectangle in tiles (`x`, `y`, `w`, `h`). For a room, the interior floor tiles; walls\nare derived around it.",
      "type": "object",
      "properties": {
        "h": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ]
    },
    "Room": {
      "type": "object",
      "properties": {
        "flooring": {
          "$ref": "#/$defs/Flooring",
          "default": "planks"
        },
        "id": {
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "id",
        "rect"
      ]
    },
    "ScheduleEntry": {
      "description": "One baseline schedule entry: at `at`, leave for the target and do `activity` there.\nThe time is a departure time; travel is computed.",
      "type": "object",
      "properties": {
        "activity": {
          "type": "string"
        },
        "at": {
          "description": "\"HH:MM\"",
          "type": "string"
        },
        "days": {
          "$ref": "#/$defs/DayPattern"
        },
        "object": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "place": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "days",
        "at",
        "activity"
      ]
    },
    "Sends": {
      "type": "object",
      "properties": {
        "good": {
          "type": "string"
        },
        "object": {
          "type": "string"
        }
      },
      "required": [
        "object",
        "good"
      ]
    },
    "TopicDef": {
      "description": "Something villagers can talk about. Code refers to it by `id`; `gloss` is how views\nshow it.",
      "type": "object",
      "properties": {
        "gloss": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "trouble": {
          "description": "Hearing this topic about someone means they are in this kind of trouble.",
          "anyOf": [
            {
              "$ref": "#/$defs/Trouble"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "gloss"
      ]
    },
    "TrackEnd": {
      "oneOf": [
        {
          "description": "The first tile of the track.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "The last tile.",
          "type": "string",
          "const": "end"
        }
      ]
    },
    "TrainRun": {
      "description": "One train on the days given: it reaches the platform at `arrive` and leaves at `depart`.\nWhen `stops` is false it passes through at `arrive` without stopping.",
      "type": "object",
      "properties": {
        "arrive": {
          "type": "string"
        },
        "days": {
          "$ref": "#/$defs/DayPattern"
        },
        "depart": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "from": {
          "description": "Which end of the track it comes from.",
          "$ref": "#/$defs/TrackEnd"
        },
        "stops": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "days",
        "arrive",
        "from"
      ]
    },
    "Trouble": {
      "description": "What a topic says about the person it concerns, when it says they are in trouble.",
      "oneOf": [
        {
          "description": "Short of money.",
          "type": "string",
          "const": "money"
        },
        {
          "description": "Going without food.",
          "type": "string",
          "const": "food"
        }
      ]
    },
    "Villager": {
      "type": "object",
      "properties": {
        "bed": {
          "description": "Object id of this villager's bed.",
          "type": "string"
        },
        "coins": {
          "description": "Money to start with.",
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "fetches": {
          "description": "Goods they collect from the goods shed when a train has stopped, paying for them.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Fetches"
          }
        },
        "home": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "income": {
          "description": "Money paid in from outside on a schedule.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Income"
          }
        },
        "name": {
          "type": "string"
        },
        "schedule": {
          "description": "Baseline schedule. Character code may extend or override it.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ScheduleEntry"
          }
        },
        "sends": {
          "description": "Goods they send by rail when a train stops: taken from `object` to the platform.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Sends"
          }
        }
      },
      "required": [
        "id",
        "name",
        "home",
        "bed"
      ]
    },
    "Walling": {
      "description": "What a building's outside walls are made of. Only the views read it.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stone",
            "brick"
          ]
        },
        {
          "description": "Half-timbered plaster.",
          "type": "string",
          "const": "timber"
        },
        {
          "description": "Rough boards: huts, barns, sheds.",
          "type": "string",
          "const": "boards"
        }
      ]
    },
    "Zone": {
      "description": "An outdoor place. One continuous grid at the same scale as interiors.",
      "type": "object",
      "properties": {
        "areas": {
          "description": "Named stretches of ground that character code refers to: a yard to weed, a field to\nwork, a bank to fish from. In zone coordinates.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AreaSpec"
          }
        },
        "arrival": {
          "description": "Where a debug warp lands.",
          "$ref": "#/$defs/Pos"
        },
        "blocked": {
          "description": "Impassable terrain (trees, rock, cliffs).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Rect"
          }
        },
        "flocks": {
          "description": "Animals kept in the zone.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/FlockSpec"
          }
        },
        "height": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "objects": {
          "description": "Things standing outdoors (a well, a privy, a bench), in zone coordinates.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectSpec"
          }
        },
        "paths": {
          "description": "Made paths and roads: cheap to walk, so routes prefer them.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Rect"
          }
        },
        "plots": {
          "description": "Tilled ground and what grows in it. Only the views read it.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PlotSpec"
          }
        },
        "railway": {
          "description": "The railway through the zone, if there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/RailwaySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "water": {
          "description": "Water: impassable, drawn as water.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Rect"
          }
        },
        "width": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "arrival"
      ]
    }
  }
}
